# Solpient Money Local — PostgreSQL runs in Docker on this Mac.
# local:setup writes DATABASE_URL and CONNECT_SECRET_ENCRYPTION_KEY
# into .env.local automatically. Do not commit the real values.
DATABASE_URL=postgresql://solpient:replace-me@127.0.0.1:5432/solpient
SOLPIENT_LOCAL_MODE=true
SOLPIENT_LOCAL_USER_EMAIL=local@solpient.local

# Canonical local origin for OAuth callback flows.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solpient Research — separate read-only public Research contract.
SOLPIENT_RESEARCH_SUPABASE_URL=https://hmfrlpsjszjpvzogrico.supabase.co
SOLPIENT_RESEARCH_PUBLISHABLE_KEY=sb_publishable_KVgQDNO-qAJAZ4KN8F1eCA_xOeEqw0m

# Solpient Research remains a separate read-only online service.
# Never add database passwords, bank credentials, Plaid secrets,
# personal financial exports, or connector tokens to GitHub.

# Plaid V0.6 — Sandbox only.
# Get PLAID_CLIENT_ID and PLAID_SECRET from the Plaid Dashboard.
# Keep PLAID_SECRET and the encryption key only in .env.local / deployment secrets.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate locally: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=

# Solpient Connect V1.3 — Direct OFX.
# Encrypts institution-issued Direct Connect/app credentials before storage.
# Generate locally: openssl rand -base64 32
CONNECT_SECRET_ENCRYPTION_KEY=

# Solpient Connect V1.4 — optional external OAuth/FDX sandbox.
# Production FDX/FAPI institutions require their own onboarding, PAR/mTLS,
# certificates, client registration, and institution-specific endpoints.
FDX_SANDBOX_AUTHORIZATION_URL=
FDX_SANDBOX_TOKEN_URL=
FDX_SANDBOX_API_BASE_URL=
FDX_SANDBOX_CLIENT_ID=
FDX_SANDBOX_CLIENT_SECRET=
FDX_SANDBOX_SCOPES="openid profile ACCOUNT_BASIC TRANSACTIONS INVESTMENTS"
